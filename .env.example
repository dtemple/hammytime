# ---------------------------------------------------------------------------
# Supabase — run `supabase start` then `supabase status` to get these values
# ---------------------------------------------------------------------------

# API URL (local: http://127.0.0.1:54321, prod: from Supabase project settings)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key from `supabase status` — safe to expose in browser bundles
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key from `supabase status` — server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Telegram — from BotFather: /newbot then /token
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Random secret (e.g. openssl rand -hex 32) — sent on every webhook request as
# X-Telegram-Bot-Api-Secret-Token; must match what you pass to setWebhook
TELEGRAM_WEBHOOK_SECRET=
# Bot username without the leading @, e.g. HammytimeBot — used for deeplinks
TELEGRAM_BOT_USERNAME=
# polling for local dev (no ngrok); webhook for production
TELEGRAM_BOT_MODE=polling

# ---------------------------------------------------------------------------
# Strava — from your app page at https://www.strava.com/settings/api
# ---------------------------------------------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
# HMAC-SHA256 key for signing OAuth state tokens — at least 32 random chars
# Generate: openssl rand -hex 32
STATE_SIGNING_KEY=
# Symmetric key for encrypting OAuth tokens at rest — exactly 32 bytes, base64
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Anthropic — from https://console.anthropic.com/settings/api-keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Admin — David's personal Telegram chat ID for shadow BCC and onboarding alerts
# Send /start to @userinfobot to get your chat ID
# ---------------------------------------------------------------------------
DAVID_TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Sentry — from your project at https://sentry.io/ → Settings → Projects → Keys
# ---------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---------------------------------------------------------------------------
# Cron auth — bearer token for /api/cron/* routes. Vercel attaches
# Authorization: Bearer ${CRON_SECRET} automatically to its own cron requests.
# Generate: openssl rand -base64 32
# Must also be set in Vercel project settings → Environment Variables.
# ---------------------------------------------------------------------------
CRON_SECRET=
